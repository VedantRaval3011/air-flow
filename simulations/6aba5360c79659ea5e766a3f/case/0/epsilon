FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}

dimensions      [0 2 -3 0 0 0 0];
internalField   uniform 0.086898;

boundaryField
{
    walls { type epsilonWallFunction; value uniform 0.008690; }
    floor { type epsilonWallFunction; value uniform 0.008690; }
    ceiling { type epsilonWallFunction; value uniform 0.008690; }

    inlet_0 { type fixedValue; value uniform 0.868984; }

    outlet_0 { type zeroGradient; }
}
